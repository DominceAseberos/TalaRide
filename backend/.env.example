PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_PUBLISHABLE_KEY=replace_with_public_publishable_key

SUPABASE_JWT_SECRET=
QR_INTENT_SECRET=replace_me

PAYMENT_MODE=mock

PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

WEB_ORIGIN=http://localhost:3000
# Set DATA_DIR only when the host provides a persistent disk mount.
DATA_DIR=
# Staging-only escape hatch. Keep false for real production.
ALLOW_EPHEMERAL_STATE=false
DEMO_AUTH=false
