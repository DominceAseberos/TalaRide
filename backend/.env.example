PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
# Server-side secret key (sb_secret_... or legacy service-role JWT). Never use a publishable key here.
# With a real server credential, development and production share the canonical Supabase backend state.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_secret_key
SUPABASE_PUBLISHABLE_KEY=replace_with_public_publishable_key

SUPABASE_JWT_SECRET=
QR_INTENT_SECRET=replace_me

PAYMENT_MODE=mock
# PAYMENT_MODE=mock enables TalaRide's server-side payment simulation and requires PAYMENT_ENVIRONMENT=test.
# Production-hosted thesis/demo deployments must also explicitly set PAYMENT_SIMULATION_ENABLED=true.
# PAYMENT_MODE=live uses PayMongo; PAYMENT_ENVIRONMENT=test keeps PayMongo sandbox checkout.
PAYMENT_ENVIRONMENT=test
PAYMENT_SIMULATION_ENABLED=false

PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_ORIGIN=https://talaride-web-frontend.vercel.app
# Set DATA_DIR only when the host provides a persistent disk mount.
DATA_DIR=
# Staging-only escape hatch. Keep false for real production.
ALLOW_EPHEMERAL_STATE=false
DEMO_AUTH=false
