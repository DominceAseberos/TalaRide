# Client configuration only: these values are bundled into the app.
# Never add a secret key, service-role key, database password, or CLI token here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use your Supabase publishable key (sb_publishable_...) or standard anon public key (JWT). Never use a service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# TalaRide public web/payment endpoints for the MVP.
# Use live for provider checkout. Use mock-server only with a backend configured PAYMENT_MODE=mock + PAYMENT_ENVIRONMENT=test.
EXPO_PUBLIC_WEB_API=https://talaride-web.onrender.com/api
EXPO_PUBLIC_PAYMENT_MODE=live
EXPO_PUBLIC_VEHICLE_QR_BASE=https://talaride-web-frontend.vercel.app/v
