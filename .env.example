# Client configuration only: these values are bundled into the app.
# Never add a secret key, service-role key, database password, or CLI token here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use your Supabase publishable key (sb_publishable_...) or standard anon public key (JWT). Never use a service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Vehicle sticker base + dynamic QR expiry + payment mode (mock-local | mock-server | live).
EXPO_PUBLIC_VEHICLE_QR_BASE=https://talaride-web-frontend.vercel.app/v
EXPO_PUBLIC_QR_EXPIRY_SEC=300
EXPO_PUBLIC_PAYMENT_MODE=mock-server
# Backend API base (Tier 2). Physical devices should call Express directly on port 4000.
EXPO_PUBLIC_WEB_API=http://YOUR_LOCAL_IP:4000/api
