# Client configuration only: these values are bundled into the app.
# Never add a secret key, service-role key, database password, or CLI token here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use your Supabase publishable key (sb_publishable_...) or standard anon public key (JWT). Never use a service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
